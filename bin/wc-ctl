#!/bin/bash
#
# wc-ctl — pi-weather-clock control script
#
# Usage: wc-ctl <command>
#   status    Show app status, memory, temperature, throttling
#   start     Start the app (via getty@tty1)
#   stop      Stop the app
#   restart   Stop then start
#   logs      Tail the watchdog log
#   kernel-log Tail kernel/dmesg for vc4 issues
#   update    Re-run installer (pulls fresh files)
#
# Must be run as root (uses systemctl, pkill).

set -euo pipefail

if [ "$EUID" -ne 0 ]; then
    echo "Run as root: sudo $0 $*"
    exit 1
fi

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

LOG_FILE="/home/kiosk/weatherClock.log"

cmd_status() {
    echo "=== weather clock status ==="
    echo
    # getty@tty1
    if systemctl is-active --quiet getty@tty1; then
        echo -e "  ${GREEN}●${NC} getty@tty1: attivo"
    else
        echo -e "  ${YELLOW}○${NC} getty@tty1: inattivo"
    fi
    # Python process(es)
    local pids
    pids=$(pgrep -f "python3.*weather_clock\\.py" 2>/dev/null || true)
    if [ -n "$pids" ]; then
        for pid in $pids; do
            local rss
            rss=$(awk '/VmRSS/{print $2}' "/proc/$pid/status" 2>/dev/null || echo 0)
            local rss_mb=$((rss / 1024))
            echo -e "  ${GREEN}●${NC} weather_clock (pid=$pid): RSS=${rss_mb}MB"
        done
    else
        echo -e "  ${YELLOW}○${NC} weather_clock: non in esecuzione"
    fi
    echo
    # Memory + swap
    echo "Memoria:"
    free -h | head -2 | tail -1 | awk '{printf "  total=%s used=%s free=%s avail=%s\n", $2, $3, $4, $7}'
    # Temperature
    if command -v vcgencmd >/dev/null; then
        local temp
        temp=$(vcgencmd measure_temp 2>/dev/null | sed 's/temp=//')
        echo "Temp: $temp"
        local throttle
        throttle=$(vcgencmd get_throttled 2>/dev/null | sed 's/throttled=//')
        if [ "$throttle" = "0x0" ]; then
            echo -e "Throttle: ${GREEN}$throttle (OK)${NC}"
        else
            echo -e "Throttle: ${RED}$throttle (WARNING)${NC}"
        fi
    fi
    echo
    # Recent log events
    if [ -f "$LOG_FILE" ]; then
        echo "Ultimi eventi watchdog:"
        tail -5 "$LOG_FILE" | sed 's/^/  /'
    fi
}

cmd_start() {
    echo "Avvio weather clock..."
    if systemctl is-active --quiet getty@tty1; then
        echo -e "  ${YELLOW}○${NC} getty@tty1 già attivo"
    else
        systemctl start getty@tty1
        echo -e "  ${GREEN}✓${NC} getty@tty1 avviato"
    fi
    # Wait for app to come up (max 20s)
    echo -n "  Attendo avvio app"
    for i in $(seq 1 20); do
        if pgrep -f "python3.*weather_clock\\.py" >/dev/null 2>&1; then
            local pid
            pid=$(pgrep -f "python3.*weather_clock\\.py" | head -1)
            echo
            echo -e "  ${GREEN}✓${NC} weather_clock attivo (pid=$pid)"
            return 0
        fi
        echo -n "."
        sleep 1
    done
    echo
    echo -e "  ${YELLOW}!${NC} weather_clock non rilevato dopo 20s (potrebbe ancora avviarsi)"
    echo "  Controlla con: sudo wc-ctl logs"
}

cmd_stop() {
    echo "Fermo weather clock..."
    if systemctl is-active --quiet getty@tty1; then
        systemctl stop getty@tty1
        echo -e "  ${GREEN}✓${NC} getty@tty1 fermato"
    else
        echo -e "  ${YELLOW}○${NC} getty@tty1 già inattivo"
    fi
    sleep 1
    # Hard kill any lingering python
    if pgrep -f "python3.*weather_clock\\.py" >/dev/null; then
        pkill -9 -f "python3.*weather_clock\\.py" 2>/dev/null || true
        echo -e "  ${GREEN}✓${NC} processi weather_clock terminati"
    fi
    echo "weather clock fermato."
    echo "Per riavviare: sudo wc-ctl start"
}

cmd_restart() {
    cmd_stop
    sleep 2
    cmd_start
}

cmd_logs() {
    if [ ! -f "$LOG_FILE" ]; then
        echo "Log file non trovato: $LOG_FILE"
        exit 1
    fi
    tail -f "$LOG_FILE"
}

cmd_kernel_log() {
    echo "Cercando errori vc4/drm/hyperpixel nel kernel log..."
    dmesg | grep -iE "vc4|drm|hyperpixel|panel" | tail -30
}

cmd_update() {
    local repo_dir="${REPO_DIR:-}"
    if [ -z "$repo_dir" ]; then
        if [ -d "$HOME/pi-weather-clock" ]; then
            repo_dir="$HOME/pi-weather-clock"
        elif [ -d "/home/pi/pi-weather-clock" ]; then
            repo_dir="/home/pi/pi-weather-clock"
        else
            echo "Set REPO_DIR or clone repo to ~/pi-weather-clock"
            exit 1
        fi
    fi
    cd "$repo_dir"
    echo "Pulling latest..."
    sudo -u pi git pull
    echo "Re-running installer..."
    sudo ./install.sh --unattended
}

# Dispatch
case "${1:-status}" in
    status)      cmd_status ;;
    start)       cmd_start ;;
    stop)        cmd_stop ;;
    restart)     cmd_restart ;;
    logs)        cmd_logs ;;
    kernel-log)  cmd_kernel_log ;;
    update)      cmd_update ;;
    --help|-h|help)
        echo "Usage: wc-ctl <status|start|stop|restart|logs|kernel-log|update>"
        ;;
    *)
        echo "Unknown command: $1"
        echo "Usage: wc-ctl <status|start|stop|restart|logs|kernel-log|update>"
        exit 1
        ;;
esac
